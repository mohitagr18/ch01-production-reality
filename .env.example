# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the default model (gemini-2.5-flash) with any
# Gemini model you have access to, e.g. gemini-2.0-flash, gemini-1.5-pro.
# Leave blank to use the default.
GEMINI_MODEL=
